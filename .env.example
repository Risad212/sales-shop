# Copy to .env and fill in:
#   cp .env.example .env

# Postgres connection (Neon / Supabase). Required — the product
# catalog lives in the database (seeded from prisma/catalog.snapshot.json).
DATABASE_URL="postgresql://user:password@host:5432/sales_shop?sslmode=require"

# Auth (NextAuth). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Agentic chat: cloud-hosted open-source LLM (OpenAI-compatible) ---
# Leave LLM_API_KEY unset to use the built-in rule-based mock assistant.
#
# Option A — Groq (free tier, fast; serves Llama/Qwen open models):
#   1. Get a key at https://console.groq.com/keys
#   LLM_API_KEY="gsk_..."
#   LLM_BASE_URL="https://api.groq.com/openai/v1"
#   LLM_MODEL="openai/gpt-oss-20b"
#
# Option B — OpenRouter (many open models: Llama, Qwen, Mistral, DeepSeek):
#   1. Get a key at https://openrouter.ai/keys
#   LLM_API_KEY="sk-or-..."
#   LLM_BASE_URL="https://openrouter.ai/api/v1"
#   LLM_MODEL="meta-llama/llama-3.1-8b-instruct"
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-20b"
# Optional (OpenRouter): your site URL for rankings
# LLM_SITE_URL="http://localhost:3000"

# --- Semantic search: embedding provider (OpenAI-compatible /embeddings) ---
# Needed for `npm run db:embed` + meaning-aware chat search ("gift for dad
# who likes tech"). Unset/misconfigured = automatic keyword fallback.
#
# Option A — Ollama (local, open model BAAI/bge-m3, 1024-dim, no key needed):
#   ollama pull bge-m3
#   EMBEDDING_BASE_URL="http://localhost:11434/v1"
#   EMBEDDING_MODEL="bge-m3"
#
# Option B — OpenRouter (cloud, key needed):
#   EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
#   EMBEDDING_MODEL="qwen/qwen3-embedding-8b"
#   EMBEDDING_API_KEY="sk-or-..."
EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_MODEL="bge-m3"
# EMBEDDING_API_KEY=""
# Set to 1 to force keyword search even when embeddings are configured
# EMBEDDING_DISABLED="0"
