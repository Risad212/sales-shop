# Copy to .env and fill in:
#   cp .env.example .env

# --- Chat AI: cloud-hosted open-source LLM (OpenAI-compatible) ---
# Leave LLM_API_KEY unset to use the built-in rule-based mock assistant.
#
# Groq (free tier, fast; serves Llama/Qwen open models):
#   1. Get a key at https://console.groq.com/keys
#   LLM_API_KEY="gsk_..."
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-20b"
